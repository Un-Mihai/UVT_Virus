# Copy to .env and fill in. Docker Compose and the API read it; never commit .env.
# docs/ai-providers.md has ready-made blocks for Azure AI Foundry, OpenAI, organiser tokens and
# local models.

# --- AI provider: any OpenAI-compatible endpoint ---------------------------------------------
# Which block below is the primary account: openai (AI_BASE_URL/AI_API_KEY, any
# OpenAI-compatible endpoint), azure (AZURE_AI_*) or bedrock (BEDROCK_*).
AI_PROVIDER=openai

# AI_PROVIDER=openai. Azure AI Foundry works here too: https://<resource>.openai.azure.com/openai/v1/
# (make azure-env prints it).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=

# AI_PROVIDER=azure: the Foundry resource's v1 endpoint and key 1 from "Keys and Endpoint".
AZURE_AI_BASE_URL=
AZURE_AI_API_KEY=

# AI_PROVIDER=bedrock: Bedrock's OpenAI-compatible endpoint, e.g.
# https://bedrock-runtime.<region>.amazonaws.com/openai/v1, a Bedrock API key and the model id
# (used instead of AI_CHAT_MODEL). Bedrock has no embeddings there: set AI_FALLBACK_* for them.
BEDROCK_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_MODEL=

# Optional second account (a teammate's Azure for Students resource, organiser tokens...).
# Used when the first fails with a bad key, exhausted credit, throttling or an outage.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=

# On Azure these are deployment names; Terraform names deployments after the models.
AI_CHAT_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column size; change both together.
AI_EMBEDDING_DIMENSIONS=1536

# --- Spend control ---------------------------------------------------------------------------
# AI calls are refused once today's estimated spend reaches this.
AI_DAILY_BUDGET_USD=5
# USD per 1M tokens for the models above (gpt-5-mini and text-embedding-3-small, Oct 2026).
AI_PRICE_INPUT_PER_MTOK=0.25
AI_PRICE_OUTPUT_PER_MTOK=2.00
AI_PRICE_EMBEDDING_PER_MTOK=0.02

# --- Document verification -----------------------------------------------------------------
# Findings each role sees: its own scope's findings at or above this confidence (0 to 1).
# Deterministic checks are always 1; AI compliance findings carry the model's confidence.
CLIENT_CONFIDENCE_THRESHOLD=0.85
REVIEWER_CONFIDENCE_THRESHOLD=0.55
# Secret key for the HMAC that compares CNPs across documents without storing them in clear.
# Unset, a development-only key is used. Generate one with `openssl rand -hex 32`; changing it
# makes earlier uploads incomparable with new ones. Terraform sets it on Azure.
# PERSONAL_DATA_HASH_KEY=
# Largest PDF a client or admin may upload.
MAX_UPLOAD_MB=25
# Parallel AI calls within one verification run (pages read, rules judged).
VERIFICATION_CONCURRENCY=4
# Characters of regulation and document text sent with each AI-judged rule.
COMPLIANCE_CONTEXT_CHARS=60000

# --- OCR for scanned PDF pages (docs/ocr.md) --------------------------------------------------
# tesseract (installed in the API image) reads pages without a text layer; none leaves them
# unread and flagged as unchecked.
OCR_ENGINE=tesseract
# Tesseract language packs, best first (the image has Romanian and English).
OCR_LANGUAGES=ron+eng
# Render resolution for OCR: 300 suits scans; lower is faster but misses small print.
OCR_DPI=300
# Pages read at once (one CPU core each), and how long one page may take.
OCR_CONCURRENCY=2
OCR_TIMEOUT_SECONDS=120

# --- Sign-in ---------------------------------------------------------------------------------
# compose.yaml sets the AUTH_* variables for Keycloak in Docker; docs/auth.md describes them.

# --- Host ports, if something else already uses them ----------------------------------------
# After changing WEB_PORT, run make reset-auth: the sign-in realm still expects the old one.
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432
KEYCLOAK_PORT=8080
